# Plantilla del .env para Bluehost. En el servidor: cp .env.produccion.example .env
# y reemplaza los valores entre < >. Luego: php artisan key:generate
APP_NAME="Congreso Saberes Andino-Amazónicos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://congresosaberes.net

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel → MySQL Databases (Bluehost antepone tu usuario de cPanel: usuario_congreso)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<usuario_cpanel>_congreso
DB_USERNAME=<usuario_cpanel>_congreso
DB_PASSWORD=<contraseña_de_la_base>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# cPanel → Email Accounts: contacto@congresosaberes.net
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.congresosaberes.net
MAIL_PORT=465
MAIL_USERNAME=contacto@congresosaberes.net
MAIL_PASSWORD=<contraseña_del_correo>
MAIL_FROM_ADDRESS="contacto@congresosaberes.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Congreso
CONGRESO_CORREO=contacto@congresosaberes.net
# Cloudflare Turnstile (opcional, anti-bots). La clave pública va en VITE_TURNSTILE_SITEKEY
# y se aplica al compilar (npm run build) en tu computadora.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITEKEY=
